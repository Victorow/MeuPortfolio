{
  "name": "victor-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run seo:build",
    "build": "next build",
    "postbuild": "node scripts/validate-jsonld.mjs out",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "assets": "node scripts/assets.mjs",
    "posters": "node scripts/posters.mjs",
    "prebuild:e2e": "npm run seo:build",
    "build:e2e": "cross-env NEXT_DIST_DIR=.next-e2e next build",
    "postbuild:e2e": "node scripts/validate-jsonld.mjs .next-e2e",
    "seo:build": "node scripts/strip-pdf.mjs && node scripts/sitemap.mjs && node scripts/llms.mjs && node scripts/validate-jsonld.mjs",
    "og": "node scripts/og.mjs",
    "audit:prod": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lenis": "^1.3.26",
    "next": "14.2.35",
    "next-intl": "^3.21.1",
    "postprocessing": "^6.39.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "jiti": "^1.21.7",
    "jsdom": "^30.1.2",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.30",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
